generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model RobotSession {
  id               String   @id @default(cuid())
  orderId          String
  robotId          String
  startedAt        DateTime?
  endedAt          DateTime?
  status           String   @default("ACTIVE")
  sessionDataJson  String?
  sessionDataHash  String?
  activityHash     String?
  hashAnchored     Boolean  @default(false)
  anchorTxHash     String?
  failureReportStatus String  @default("NONE")
  auditStatus      String   @default("NOT_ANCHORED")
  telemetry        RobotTelemetry[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([robotId])
}

model RentalSnapshot {
  id                String   @id @default(cuid())
  orderId           String   @unique
  robotId           String
  customerAddress   String
  service           String
  durationMinutes   Int
  amountInr         Int
  amountPaidWei     String
  startTime         BigInt?
  endTime           BigInt?
  active            Boolean  @default(false)
  completed         Boolean  @default(false)
  status            String   @default("ACTIVE")
  paymentStatus     String   @default("ESCROWED")
  rentalDataHash    String?
  activityHash      String?
  failureReasonHash String?
  settledAt         BigInt?
  creationTxHash    String?
  settlementTxHash  String?
  refundTxHash      String?
  lastSyncedBlock   Int?
  lastSyncedBlockHash String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([robotId])
  @@index([customerAddress])
}

model ActivityAudit {
  id               String   @id @default(cuid())
  orderId          String
  robotId          String
  eventType        String
  payloadJson      String?
  payloadHash      String?
  timestamp        DateTime
  blockchainAnchored Boolean @default(false)
  anchorTxHash     String?
  status           String   @default("NOT_ANCHORED")
  sessionDataHash  String?
  createdAt        DateTime @default(now())

  @@index([orderId])
  @@index([robotId])
  @@index([timestamp])
}

model BlockchainEvent {
  id               String   @id @default(cuid())
  txHash           String
  logIndex         Int
  eventKey         String   @unique
  blockNumber      Int
  blockHash        String?
  blockTimestamp   DateTime
  contractAddress  String
  eventName        String
  eventDataJson    String
  processed        Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([blockNumber])
  @@index([eventName])
}

model RobotTelemetry {
  id               String   @id @default(cuid())
  robotId          String
  orderId          String?
  timestamp        DateTime
  telemetryJson    String
  telemetryHash    String
  sessionId        String?
  session          RobotSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([robotId])
  @@index([orderId])
  @@index([timestamp])
}

model VerificationRecord {
  id                String   @id @default(cuid())
  orderId           String
  verificationType  String
  computedHash      String
  storedHash        String?
  verified          Boolean  @default(false)
  transactionHash   String?
  createdAt         DateTime @default(now())

  @@index([orderId])
  @@index([verificationType])
}

model FailureEvidence {
  id               String   @id @default(cuid())
  orderId          String
  robotId          String
  customerAddress  String?
  failureType      String
  description      String
  evidenceJson     String
  evidenceHash     String
  status           String   @default("REPORTED")
  reviewedBy       String?
  reviewedAt       DateTime?
  refundTxHash     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([robotId])
  @@index([status])
}

model TransactionRecord {
  txHash           String   @id
  orderId          String?
  type             String
  fromAddress      String?
  toAddress        String?
  valueWei         String?
  blockNumber      Int?
  status           String
  createdAt        DateTime @default(now())

  @@index([orderId])
  @@index([type])
  @@index([status])
}

model RobotSnapshot {
  robotId          String   @id
  name             String
  service          String
  ownerAddress     String
  status           String
  registered       Boolean
  lastSyncedBlock  Int
  updatedAt        DateTime @updatedAt
}

model SyncState {
  id                 String   @id @default("blockchain")
  lastProcessedBlock Int      @default(0)
  lastProcessedHash  String?
  updatedAt          DateTime @updatedAt
}
