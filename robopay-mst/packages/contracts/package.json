{
  "name": "contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "hardhat node",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "lint": "solhint \"contracts/**/*.sol\"",
    "mark:legacy": "hardhat run scripts/markLegacyDeployment.ts",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network testnet",
    "verify:testnet": "hardhat run scripts/verify.ts --network testnet",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "@openzeppelin/contracts": "~5.0.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/prompt-sync": "^4.2.3",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.10",
    "prompt-sync": "^4.2.0",
    "solhint": "^5.0.3",
    "typescript": "^5.5.4"
  }
}
